# Copia este archivo a .env y completa tus valores reales.
# .env NUNCA se commitea (ver .gitignore) — vive solo en tu máquina/sesión.

# Requerida por content_planner.py, script_writer.py, tts_gemini.py,
# veo_broll.py, manim_broll.py y publisher.py.
# Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional, solo para actualizar_musica.py (música de fondo).
# Gratis en https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# Las credenciales de YouTube (client_secret.json / youtube_token.json) NO
# van en .env por su formato (son archivos JSON de OAuth) — ver README.md
# "Publicación en YouTube" para generarlas.
